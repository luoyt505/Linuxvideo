#!/usr/bin/env bash
# mediahub-cli 启动脚本：自动激活虚拟环境后转发给 Python CLI。
# 用法：./mediahub-cli scan --dir /media/movies
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if [ -d .venv ]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
else
  echo "[WARN] 未找到 .venv，将使用系统 Python。建议先执行 ./install.sh" >&2
fi

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

exec python3 -m cli.mediahub_cli "$@"
